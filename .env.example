# ─── Required for GEO Module (at least one LLM key needed) ───
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...

# ─── Free: Google PageSpeed Insights (Core Web Vitals & Lighthouse) ───
GOOGLE_PSI_API_KEY=AIza...

# ─── Optional: Google Custom Search (AI Overview detection) ───
GOOGLE_SEARCH_API_KEY=AIza...
GOOGLE_SEARCH_CX=...

# ─── Optional: DataForSEO (keyword data, traffic estimates) ───
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ─── Optional: SimilarWeb (traffic intelligence) ───
SIMILARWEB_API_KEY=
